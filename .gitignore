# pyenv
#   For a library or package, you might want to ignore these files since the Python version is
#   controlled by the user.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or even
#   fail all together.
#Pipfile.lock

# poetry
#   Similar to Pipenv, see https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipenv, see https://pdm.fming.dev/latest/usage/project/#commit-the-lock-file
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/frenzymadness/venkr
__pypackages__/

